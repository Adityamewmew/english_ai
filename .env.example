# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# AI Gateway / Proxy
AI_BASE_URL="http://localhost:20128/v1"
AI_API_KEY="your-api-key"
AI_CHAT_MODEL="gemini/gemini-3.1-flash-lite"
AI_AUDIO_MODEL="elevenlabs/eleven_turbo_v2_5"
AI_AUDIO_VOICE="your-voice-id"

GEMINI_LIVE_MODEL="antigravity/gemini-3.7-flash-high"
GEMINI_EVAL_MODEL="antigravity/gemini-3.7-flash-high"

# Direct Gemini API (fallback)
GEMINI_API_KEY=""

# Next.js App Secret
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"
